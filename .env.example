# GitHub OAuth App credentials (https://github.com/settings/developers)
# Used for Basic auth — raises rate limit from 60 to 5000 req/hour
# Production: set GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET in Netlify
REACT_APP_GITHUB_CLIENT_ID=your_client_id_here
REACT_APP_GITHUB_CLIENT_SECRET=your_client_secret_here
